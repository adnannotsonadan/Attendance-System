<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
    <div class="login-container">
        <div class="login-form">
            <h1>School Management System</h1>
            <p class="login-subtitle">Please select your role and login</p>
            
            <% if (error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-group">
                    <label for="role">Select Role:</label>
                    <select name="role" id="role" required onchange="updateCredentials()">
                        <option value="">-- Select Role --</option>
                        <option value="admin">Admin</option>
                        <option value="teacher">Teacher</option>
                        <option value="student">Student</option>
                    </select>
                </div>

                <!-- Section selector removed for simplicity -->

                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <button type="submit" class="login-btn">Login</button>
            </form>

            <div class="demo-credentials">
                <h3>Demo Credentials for Testing:</h3>
                <div class="credential-section">
                    <strong>Admin:</strong> admin@school.com / admin123
                </div>
                <div class="credential-section">
                    <strong>Teacher:</strong> teacher@school.com / teacher123
                </div>
                <div class="credential-section">
                    <strong>Student:</strong> student@school.com / student123
                </div>
                <p class="demo-note">🎓 1st Standard School System (7 Sections A-G, 10 students each)</p>
                <p class="demo-note">📚 Subjects: English, Math, Science</p>
            </div>
        </div>
    </div>

    <script>
        function updateCredentials() {
            const role = document.getElementById('role').value;
            const emailField = document.getElementById('email');
            const passwordField = document.getElementById('password');
            
            switch(role) {
                case 'admin':
                    emailField.value = 'admin@school.com';
                    passwordField.value = 'admin123';
                    break;
                case 'teacher':
                    emailField.value = 'teacher@school.com';
                    passwordField.value = 'teacher123';
                    break;
                case 'student':
                    emailField.value = 'student@school.com';
                    passwordField.value = 'student123';
                    break;
                default:
                    emailField.value = '';
                    passwordField.value = '';
            }
        }
        // Simple script - no complex section handling needed
    </script>
</body>
</html>