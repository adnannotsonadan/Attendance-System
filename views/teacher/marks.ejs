<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="dashboard">
        <div class="sidebar">
            <h2>Teacher Panel</h2>
            <ul>
                <li><a href="/teacher/dashboard">Dashboard</a></li>
                <li><a href="/teacher/attendance">Attendance</a></li>
                <li><a href="/teacher/marks" class="active">Marks</a></li>
                <li><a href="/teacher/timetable">Timetable</a></li>
            </ul>
        </div>
        
        <div class="main-content">
            <div class="header">
                <h1><%= title %> - Class <%= className %></h1>
                <div>
                    <span>Welcome, <%= user.name %></span>
                    <a href="/logout" class="logout-btn">Logout</a>
                </div>
            </div>

            <!-- Success/Error Messages -->
            <% if (typeof success !== 'undefined') { %>
                <div class="alert alert-success">
                    <%= success %>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined') { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
            <% } %>

            <!-- Add Marks Form -->
            <div class="form-container">
                <h3>Add New Marks</h3>
                <form action="/teacher/marks/add" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="student_id">Student:</label>
                            <select id="student_id" name="student_id" required>
                                <option value="">Select Student</option>
                                <% students.forEach(student => { %>
                                    <option value="<%= student.id %>"><%= student.name %> (<%= student.roll_no %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="subject_id">Subject:</label>
                            <select id="subject_id" name="subject_id" required>
                                <option value="">Select Subject</option>
                                <% subjects.forEach(subject => { %>
                                    <option value="<%= subject.id %>"><%= subject.subject_name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="exam_name">Exam/Test Name:</label>
                            <input type="text" id="exam_name" name="exam_name" required placeholder="e.g., Mid-term, Unit Test 1">
                        </div>
                        <div class="form-group">
                            <label for="total_marks">Total Marks:</label>
                            <input type="number" id="total_marks" name="total_marks" required min="1" placeholder="e.g., 100">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="marks_obtained">Marks Obtained:</label>
                            <input type="number" id="marks_obtained" name="marks_obtained" required min="0" placeholder="e.g., 85">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Marks</button>
                </form>
            </div>

            <!-- Existing Marks -->
            <div class="table-container">
                <div class="table-header">
                    <h3>Marks Records</h3>
                </div>
                <% if (marks.length > 0) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Student</th>
                                <th>Roll No</th>
                                <th>Subject</th>
                                <th>Exam</th>
                                <th>Marks</th>
                                <th>Total</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% marks.forEach(mark => { %>
                                <tr>
                                    <td><%= new Date(mark.date).toLocaleDateString() %></td>
                                    <td><%= mark.student_name %></td>
                                    <td><%= mark.roll_no %></td>
                                    <td><%= mark.subject_name %></td>
                                    <td><%= mark.exam_name %></td>
                                    <td><%= mark.marks_obtained %></td>
                                    <td><%= mark.total_marks %></td>
                                    <td>
                                        <% 
                                        const markPercentage = ((mark.marks_obtained / mark.total_marks) * 100);
                                        let grade = 'F';
                                        if (markPercentage >= 90) grade = 'A+';
                                        else if (markPercentage >= 80) grade = 'A';
                                        else if (markPercentage >= 70) grade = 'B';
                                        else if (markPercentage >= 60) grade = 'C';
                                        else if (markPercentage >= 50) grade = 'D';
                                        %>
                                        <span class="percentage-badge percentage-<%= markPercentage >= 60 ? 'pass' : 'fail' %>">
                                            <%= markPercentage.toFixed(1) %>%
                                        </span>
                                    </td>
                                    <td>
                                        <span class="grade-badge grade-<%= grade.replace('+', 'plus') %>">
                                            <%= grade %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div style="padding: 20px; text-align: center;">
                        <p>No marks records found.</p>
                        <p>Add your first marks entry using the form above.</p>
                    </div>
                <% } %>
            </div>

            <!-- Class Performance Summary -->
            <% if (marks.length > 0) { %>
                <div class="stats-cards">
                    <div class="card">
                        <h3>Total Entries</h3>
                        <div class="number" style="color: #3498db;">
                            <%= marks.length %>
                        </div>
                    </div>
                    <div class="card">
                        <h3>Class Average</h3>
                        <div class="number" style="color: #2ecc71;">
                            <% 
                            const totalPercentage = marks.reduce((sum, mark) => sum + ((mark.marks_obtained / mark.total_marks) * 100), 0);
                            const average = (totalPercentage / marks.length).toFixed(1);
                            %>
                            <%= average %>%
                        </div>
                    </div>
                    <div class="card">
                        <h3>Pass Rate</h3>
                        <div class="number" style="color: #f39c12;">
                            <% 
                            const passCount = marks.filter(mark => ((mark.marks_obtained / mark.total_marks) * 100) >= 60).length;
                            const passRate = ((passCount / marks.length) * 100).toFixed(1);
                            %>
                            <%= passRate %>%
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <style>
        .percentage-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        .percentage-pass {
            background: #d4edda;
            color: #155724;
        }
        .percentage-fail {
            background: #f8d7da;
            color: #721c24;
        }
        
        .grade-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
            color: white;
        }
        .grade-Aplus { background: #28a745; }
        .grade-A { background: #20c997; }
        .grade-B { background: #17a2b8; }
        .grade-C { background: #ffc107; color: #212529; }
        .grade-D { background: #fd7e14; }
        .grade-F { background: #dc3545; }
    </style>

    <script>
        // Validate marks obtained doesn't exceed total marks
        document.getElementById('marks_obtained').addEventListener('input', function() {
            const totalMarks = parseInt(document.getElementById('total_marks').value) || 0;
            const marksObtained = parseInt(this.value) || 0;
            
            if (marksObtained > totalMarks) {
                this.value = totalMarks;
            }
        });
        
        document.getElementById('total_marks').addEventListener('input', function() {
            const marksObtained = parseInt(document.getElementById('marks_obtained').value) || 0;
            const totalMarks = parseInt(this.value) || 0;
            
            if (marksObtained > totalMarks) {
                document.getElementById('marks_obtained').value = totalMarks;
            }
        });
    </script>
</body>
</html>